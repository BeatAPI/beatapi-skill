{
  "name": "beatapi-skill",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Skill for creating and managing BeatAPI AI video workflows.",
  "type": "module",
  "scripts": {
    "contract:sync": "node scripts/contract.mjs --write",
    "contract:check": "node scripts/contract.mjs --check",
    "validate:skill": "node scripts/validate-skill.mjs",
    "submission:build": "node scripts/build-submission.mjs",
    "test": "node --test",
    "verify": "npm run contract:check && npm run validate:skill && npm test && npm run submission:build"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatAPI/beatapi-skill.git"
  },
  "bugs": {
    "url": "https://github.com/BeatAPI/beatapi-skill/issues"
  },
  "homepage": "https://docs.beatapi.io/",
  "keywords": [
    "agent-skill",
    "codex",
    "beatapi",
    "ai-video",
    "music-video",
    "ecommerce-video"
  ],
  "license": "MIT"
}
